<?xml version="1.0" encoding="UTF-8"?>
<!--
  BUILD FILE (Maven)
  What: declares the Java version, the libraries this service depends on, and how tests run.
  Why these libraries (each maps to a résumé bullet, see docs/LEARNING_GUIDE.md):
    - spring-boot-starter-web ........ the REST API (api/ package)
    - spring-boot-starter-jdbc ....... plain SQL via JdbcClient. We avoid JPA on purpose: a ledger needs
                                       exact control over locking (SELECT ... FOR UPDATE) and inserts.
    - spring-boot-starter-validation . rejects bad JSON before it reaches the money math
    - flyway ......................... versioned schema in src/main/resources/db/migration
    - postgresql ..................... the JDBC driver; the schema relies on Postgres triggers and row locks
    - testcontainers ................. integration tests start a throwaway Postgres in Docker, so tests
                                       exercise the SAME triggers and locks production uses
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inheriting from the Boot parent pins compatible versions for every Spring/Testcontainers/Flyway jar,
         which is why most dependencies below have no <version>. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jacobbelay</groupId>
    <artifactId>royalty-split-ledger</artifactId>
    <version>0.1.0</version>
    <name>royalty-split-ledger</name>
    <description>Splits music royalties among collaborators on an append-only double-entry ledger.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Override the version the Spring Boot parent manages (1.19.8).
             Why: 1.19.8's Docker client asks for Docker API version 1.32, and Docker Engine 25+ refuses
             anything below 1.40 ("client version 1.32 is too old"). On a current Docker install EVERY
             integration test therefore fails before it starts, in CI and on a developer's laptop alike.
             1.21.4 negotiates a supported version. Verified against Docker Engine 29.9.2 (min API 1.40):
             all 60 integration tests pass. Do not drop back below 1.20 without re-testing this. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Authentication/authorization: the filter chain, BCrypt, and @PreAuthorize (security/ package). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Brings spring-security-oauth2-jose (Nimbus), which both SIGNS our tokens (NimbusJwtEncoder in
             security/TokenService) and VERIFIES them on every request (NimbusJwtDecoder in SecurityConfig).
             Using the resource-server starter rather than a hand-rolled filter means Spring does the parsing,
             signature check and expiry check, which is exactly the code you do not want to write yourself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10+ ships database support as separate modules; without this one it refuses to talk to Postgres. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test-only ===== -->
        <!-- Brings JUnit 5, AssertJ, Mockito and MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc security helpers; also lets @AutoConfigureMockMvc install the real security filter chain,
             so the API tests go through authentication exactly as a real request would. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Unit tests (*Test.java) run in `mvn test`; database tests (*IT.java) run in `mvn verify`.
                 Keeping them apart means the fast math tests give feedback in seconds, even without Docker. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- COVERAGE (JaCoCo)
                 Why two agents: unit tests (surefire) and integration tests (failsafe) run in different JVMs,
                 each writing its own .exec file. `merge` combines them, so the report credits a line whether
                 a unit test or a Testcontainers test exercised it. Without the merge, the ledger/payout
                 numbers would look far worse than they are, since most of that logic is proven by *IT tests.

                 `check` then FAILS the build if the payout or ledger package drops below 90% line AND
                 instruction coverage. That is what makes the coverage claim a guarantee rather than a
                 snapshot: it cannot silently rot on the next commit.

                 Report lands in target/site/jacoco/index.html after `mvn verify`. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>agent-unit</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>merge-exec-files</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco-unit.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                    <!-- Both bound to `verify`; plugins run in declaration order, so the report is written
                         before the gate reads the same merged data. -->
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coverage-gate-payout-and-ledger</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <!-- element=PACKAGE evaluates each listed package on its own, so one package
                                     cannot hide behind the other's coverage. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.jacobbelay.royalty.payout</include>
                                        <include>com.jacobbelay.royalty.ledger</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
